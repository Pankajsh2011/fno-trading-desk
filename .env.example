# ==============================================================
# 🤖 FNO TRADING BOT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your details:
# ==============================================================

PORT=3001

# --- DHAN HQ API CREDENTIALS ---
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_24hr_access_token_here
DHAN_PIN=your_6_digit_pin_here
DHAN_TOTP_SECRET=your_totp_secret_key_here

# --- TELEGRAM INSTANT ALERTS ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- OPENALGO BRIDGE (OPTIONAL) ---
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_APP_NAME=openalgobot
OPENALGO_API_KEY=your_openalgo_api_key_here
OPENALGO_API_SECRET=your_openalgo_api_secret_here

# --- RISK PARAMETERS ---
MAX_CAPITAL_RISK_PERCENT=1.0
MAX_DAILY_TRADES=5
RISK_REWARD_RATIO=2.0
MIN_BODY_ENGULFING_RATIO=1.20
MAX_WICK_RATIO=0.40
